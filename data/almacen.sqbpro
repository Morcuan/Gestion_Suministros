CREATE VIEW v_consumos as SELECT ncontrato, strftime('%m-%Y', inicio_factura) AS mes_año,
consumo_punta AS Punta, consumo_llano AS Llano, consumo_valle AS Valle,
excedentes AS Excedentes
FROM facturas</sql><current_tab id="1"/></tab_sql></sqlb_project>
